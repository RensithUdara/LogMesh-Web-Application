LOGMESH_ENV=development
LOGMESH_HTTP_ADDR=:8081
LOGMESH_LOG_LEVEL=info
LOGMESH_MAX_STORED_LOGS=10000
LOGMESH_REQUIRE_API_KEY=false
LOGMESH_RATE_LIMIT_REQUESTS=120
LOGMESH_RATE_LIMIT_WINDOW_SECONDS=60
LOGMESH_JWT_SECRET=change-me-in-production
LOGMESH_KAFKA_BROKERS=localhost:9092
LOGMESH_KAFKA_LOGS_TOPIC=logs
LOGMESH_KAFKA_DLQ_TOPIC=logs-dlq
LOGMESH_OPENSEARCH_URL=http://localhost:9200
LOGMESH_POSTGRES_URL=postgres://logmesh:logmesh@localhost:5432/logmesh?sslmode=disable
LOGMESH_REDIS_URL=redis://localhost:6379/0
LOGMESH_PROCESSOR_WORKERS=4
LOGMESH_PROCESSOR_BATCH_SIZE=500
LOGMESH_PROCESSOR_BATCH_MS=1000
